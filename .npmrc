# ignore-scripts is intentionally NOT set here (re: PER-9533). This example
# depends on electron (via nightmare), whose postinstall downloads the Electron
# binary; blocking lifecycle scripts leaves it uninstalled ("Electron failed to
# install correctly") and, on npm 6, also suppresses `npm test`/`percy exec` —
# so no Percy build is produced and the percy/* status never reports.
strict-ssl=true
save-exact=true
audit-level=high
engine-strict=true
legacy-peer-deps=false
min-release-age=7
